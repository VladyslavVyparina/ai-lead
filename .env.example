# App
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./pipeline.db
# CORS origins allowed to submit preview-site forms. Leave empty to auto-build
# from PUBLIC_BASE_URL + localhost + 127.0.0.1 + *.vercel.app
# PREVIEW_ORIGIN_REGEX=
PUBLIC_BASE_URL=http://localhost:8000

# Inbound webhook shared secret (generic inbound contract, P0)
INBOUND_WEBHOOK_SECRET=change_this_secret

# Operator auth (simple header token for P0 control plane)
ADMIN_TOKEN=change_this_token

# LLM providers (used only by bounded agents; deterministic path never requires them)
OPENAI_API_KEY=
CHAT_MODEL=gpt-4o-mini

# Hosting adapter (P0: Vercel-first, provider-replaceable)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
VERCEL_GITHUB_REPO_ID=
VERCEL_GIT_REF=main

# Per-lead budget caps (EUR-equivalent units; work stops/downgrades before overspend)
PER_LEAD_TOKEN_BUDGET=2.0
